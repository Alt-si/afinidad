# Copiá este archivo como .env para correr la app en tu compu.

# Base de datos PostgreSQL. En Render se completa sola con el blueprint.
DATABASE_URL=postgres://usuario:clave@localhost:5432/afinidad
# Poné true solo si te conectás desde afuera de Render con la "External Database URL"
DATABASE_SSL=false

# Texto largo y aleatorio (mínimo 32 caracteres). En Render se genera solo.
JWT_SECRET=cambiame-por-un-texto-largo-y-aleatorio-de-mas-de-32

# Porcentaje mínimo de coincidencia
MATCH_THRESHOLD=70

# Correo con Brevo (brevo.com). Si lo dejás vacío, el código sale en la consola.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Afinidad

# SMS con Twilio Verify (twilio.com). Si lo dejás vacío, el código sale en la consola.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
